@echo off
REM HK50 Robot Launcher
cd /d "%~dp0"

set CMD=%1
if "%CMD%"=="" set CMD=--report

if "%CMD%"=="--loop"      goto loop
if "%CMD%"=="--execute"   goto execute
if "%CMD%"=="--diagnose"  goto diagnose
if "%CMD%"=="--report"    goto report
if "%CMD%"=="--retrain"   goto retrain
if "%CMD%"=="--dashboard" goto dashboard
if "%CMD%"=="--stop"      goto stop

:usage
echo Usage: run_hk50.bat [--loop^|--execute^|--diagnose^|--report^|--retrain^|--dashboard^|--stop]
goto end

:loop
echo Starting HK50 robot (paper mode, loop)...
start "HK50_robot" py -3 live_runner.py --loop
goto end

:execute
echo Starting HK50 robot (LIVE EXECUTION)...
start "HK50_robot" py -3 live_runner.py --loop --execute
goto end

:diagnose
py -3 live_runner.py --diagnose
goto end

:report
py -3 execution_tracker.py --report
goto end

:retrain
py -3 retrainer.py
goto end

:dashboard
echo Starting HK50 dashboard on port 8091...
start "HK50_dash" py -3 dashboard.py
timeout /t 2 >nul
start http://localhost:8091
goto end

:stop
echo Stopping HK50 robot...
taskkill /FI "WINDOWTITLE eq HK50_robot" /F 2>nul
taskkill /FI "WINDOWTITLE eq HK50_dash"  /F 2>nul
echo Done.
goto end

:end
