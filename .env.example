# AgroCast PRO — environment variables
# Copy to .env for local development; in Render set them in the Dashboard.

# ── LLM (capa intel + brief semanal) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── News sources ─────────────────────────────────────────
NEWSAPI_KEY=

# ── Alertas Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alertas WhatsApp (Twilio, opcional) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── API key del propio AgroCast (auth en /api/*) ─────────
# Si no se setea, se genera una al arrancar y se imprime en logs.
AGROCAST_API_KEY=puiMyUde4xAAkNqX6sCkaYj_h2Sl-dFKwjPAQR1ib8E

# ── Runtime / deployment ─────────────────────────────────
# Web (gunicorn)
PORT=8000

# Render-only: dejar comentado en local.
# RUN_SCHEDULER=1
# BOOTSTRAP_PIPELINE=1
# DATA_DIR=/var/data/data
# ARTIFACTS_DIR=/var/data/artifacts

# Pipeline cadence
PIPELINE_INTERVAL_H=6
BRIEF_HOUR=8

# Fast start: salta el pipeline al boot si ya hay artifacts
AGROCAST_FAST_START=1

# CORS (frontend separado en Vercel, etc)
CORS_ORIGINS=*

# Postgres (lo inyecta Render automáticamente; en local opcional)
# DATABASE_URL=postgresql://user:pass@localhost:5432/agrocast

# Timezone
TZ=America/Montevideo
